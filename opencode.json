{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "pyright": { "disabled": true },
    "basedpyright": {
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py"]
    },
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py"]
    }
  }
}