{
  "name": "qbsearch",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/website"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "setup": "bun tool/entry.ts setup",
    "check": "bun tool/entry.ts check",
    "gen": "bun tool/entry.ts gen",
    "plugin": "bun tool/entry.ts plugin",
    "test": "bun tool/entry.ts test",
    "release": "bun tool/entry.ts release",
    "help": "bun tool/entry.ts help",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint \"test/**/*.ts\" \"tool/**/*.ts\" \"packages/website/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "static-check": "bun tool/entry.ts check -- --fast",
    "python:check": "bun tool/checks/command.ts python",
    "catalog": "bun tool/entry.ts gen -- --write --only catalog",
    "harden": "bun tool/entry.ts gen -- --check --only harden",
    "icons": "bun tool/entry.ts gen -- --write --only icons",
    "test:watch": "bun tool/entry.ts test -- --watch",
    "test:live": "bun tool/entry.ts test -- --live",
    "test:live:watch": "bun tool/entry.ts test -- --live --watch",
    "upstream": "bun tool/entry.ts upstream"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.0",
    "@types/node": "26.2.0",
    "cross-image": "0.4.3",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "fflate": "0.8.3",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
