{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["bun", "node"]
  },
  "include": ["test/**/*.ts", "tool/**/*.ts", "packages/website/**/*.{ts,tsx}"],
  "exclude": [
    "node_modules",
    "external",
    "documentation",
    "catalog",
    "working",
    "dist",
    "build",
    "**/.next",
    ".opencode",
    ".venv",
    ".ruff_cache",
    "**/__pycache__/**"
  ]
}
